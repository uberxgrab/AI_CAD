<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>HvacAiCadAddin</RootNamespace>
    <AssemblyName>HvacAiCadAddin</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The ZWCAD build (HvacAiCadAddin.Zw.csproj) keeps its mapped sources and output here. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\Zw\**;bin\Zw\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Sets $(AcadDir): the installed AutoCAD whose managed DLLs are referenced. -->
  <Import Project="AcadDir.props" />

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <StartAction>Program</StartAction>
    <StartProgram>$(AcadDir)\acad.exe</StartProgram>
    <StartArguments>/nologo /b "C:\Users\Admin\hvac_ai\cad_addin\start.scr"</StartArguments>
    <StartWorkingDirectory>$(AcadDir)</StartWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AcadDir)\AcCoreMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AcadDir)\AcDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AcadDir)\AcMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
