{
    "cmake.sourceDirectory": "C:/Users/Admin/hvac_ai/cad_addin",

    // Copilot agent mode: terminal commands that run without asking.
    // Keys are a command prefix or a /regex/; true = auto-approve, false = always ask.
    // Without this, the confirmation only offers "Allow once".
    "chat.tools.terminal.enableAutoApprove": true,
    "chat.tools.terminal.autoApprove": {
        // Changing to the repo folder (Copilot often prefixes "cd <repo>;")
        "/^(cd|Set-Location)\\b/": true,
        // Python from the repo venv, relative or absolute path, with or without & "..."
        "/^&?\\s*\"?([A-Za-z]:)?[^\"]*venv[\\\\/]Scripts[\\\\/]python(\\.exe)?\"?\\s/": true,
        // Build the add-in and run the C# test projects
        "/^&?\\s*\"?dotnet(\\.exe)?\"? (build|run|test|restore|--info|--list-sdks)\\b/": true,
        // Headless AutoCAD test scripts
        "/^powershell(\\.exe)?( -\\w+)* -File \"?([A-Za-z]:)?[^\"]*tests[\\\\/]/": true,
        // Read-only git
        "/^git (status|diff|log|show|branch|rev-parse|ls-files)\\b/": true,
        // Read-only shell helpers
        "/^(Get-ChildItem|ls|dir|Get-Content|cat|type|Select-String|Test-Path|Get-Location|pwd|where\\.exe|Get-Command)\\b/": true,

        // Always ask for these
        "git push": false,
        "git commit": false,
        "git reset": false,
        "git clean": false,
        "git checkout": false,
        "Remove-Item": false,
        "rm": false,
        "del": false
    }
}
