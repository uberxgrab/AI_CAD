<Project>
  <!--
    Console tests for the HVACQTO pure logic. Sdk.props is imported explicitly so
    the build folders can be set first: bin/ and obj/ stay outside the repository,
    which has no .gitignore.
  -->
  <PropertyGroup>
    <HvacQtoBuildRoot>$([System.IO.Path]::GetTempPath())HvacQtoCoreTests\</HvacQtoBuildRoot>
    <BaseIntermediateOutputPath>$(HvacQtoBuildRoot)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(HvacQtoBuildRoot)bin\</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>HvacQtoCoreTests</RootNamespace>
    <AssemblyName>HvacQtoCoreTests</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Lets a mutation check compile the harness against a copy of Core. -->
    <HvacQtoCoreSource Condition="'$(HvacQtoCoreSource)' == ''">..\..\cad_addin\src\HvacQuantityTakeoffCore.cs</HvacQtoCoreSource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(HvacQtoCoreSource)" Link="HvacQuantityTakeoffCore.cs" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
