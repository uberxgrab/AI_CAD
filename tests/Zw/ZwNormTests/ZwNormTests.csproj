<Project>
  <!-- ZWCAD twin of tests\NormCoreTests\Acad (same test files, same cad_addin\src files; keep the lists in step). -->
  <PropertyGroup>
    <ZwSuite>norm</ZwSuite>
    <RootNamespace>NormAcadTests</RootNamespace>
    <AssemblyName>NormAcadTests</AssemblyName>
  </PropertyGroup>

  <Import Project="..\ZwTests.props" />
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="..\..\..\cad_addin\ZwDir.props" />

  <ItemGroup>
    <ZwMapInput Include="..\..\NormCoreTests\Acad\NormAcadTests.cs" Link="t\%(Filename)%(Extension)" />
    <ZwMapInput Include="..\..\..\cad_addin\src\NormCore.cs" Link="NormCore.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\SizeTagCore.cs" Link="SizeTagCore.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\NormExchange.cs" Link="NormExchange.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\NormWriter.cs" Link="NormWriter.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\RoomsCore.cs" Link="RoomsCore.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\RoomsExchange.cs" Link="RoomsExchange.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\TemplateImport.cs" Link="TemplateImport.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\TestMode.cs" Link="TestMode.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\HvacQuantityTakeoffCore.cs" Link="HvacQuantityTakeoffCore.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\DuctGeometryCore.cs" Link="DuctGeometryCore.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\DuctBlockLibrary.cs" Link="DuctBlockLibrary.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\DynamicBlockHelpers.cs" Link="DynamicBlockHelpers.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\DuctLineCore.cs" Link="DuctLineCore.cs" />
    <ZwMapInput Include="..\..\..\cad_addin\src\DuctLineWriter.cs" Link="DuctLineWriter.cs" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
    <Reference Include="ZwManaged">
      <HintPath>$(ZwDir)\ZwManaged.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ZwDatabaseMgd">
      <HintPath>$(ZwDir)\ZwDatabaseMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="..\..\..\cad_addin\ZwMap.targets" />
</Project>
