<Project>
  <!--
    Test DLL of the scripted end-to-end tests, for accoreconsole (AutoCAD 2023). It builds the scenario drawings
    and dumps drawings as JSON. It links the add-in sources it needs, and references only AcDbMgd and AcCoreMgd
    (never AcMgd). The ZWCAD twin is tests\Zw\ZwScriptedTests (same file list; keep them in step).
    Build folders stay in %TEMP%. Run it through run-acad-scripted.ps1.
  -->
  <PropertyGroup>
    <ScriptedBuildRoot>$([System.IO.Path]::GetTempPath())HvacScripted\build\acad\</ScriptedBuildRoot>
    <BaseIntermediateOutputPath>$(ScriptedBuildRoot)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(ScriptedBuildRoot)bin\</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ScriptedTests</RootNamespace>
    <AssemblyName>ScriptedTests</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <Import Project="..\..\..\cad_addin\AcadDir.props" />

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\..\cad_addin\src\DynamicBlockHelpers.cs" Link="DynamicBlockHelpers.cs" />
    <Compile Include="..\..\..\cad_addin\src\TemplateImport.cs" Link="TemplateImport.cs" />
    <Compile Include="..\..\..\cad_addin\src\TestMode.cs" Link="TestMode.cs" />
    <Reference Include="AcDbMgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
