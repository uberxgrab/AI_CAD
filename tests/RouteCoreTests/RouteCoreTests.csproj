<Project>
  <!--
    Console tests for the AutoCAD-free HVACROUTEDRAFT core (cad_addin/src/RouteDraftCore.cs): tree
    geometry, invariants, remembered settings, and acceptance of a draft by the HVACREFRIG cleaner core.
    Sdk.props is imported explicitly so the build folders can be set first: bin/ and obj/ stay in
    %TEMP%, outside the repository and outside cad_addin/ (whose SDK glob would compile this project
    into the add-in).
  -->
  <PropertyGroup>
    <RouteCoreBuildRoot>$([System.IO.Path]::GetTempPath())RouteCoreTests\</RouteCoreBuildRoot>
    <BaseIntermediateOutputPath>$(RouteCoreBuildRoot)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(RouteCoreBuildRoot)bin\</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>RouteCoreTests</RootNamespace>
    <AssemblyName>RouteCoreTests</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vec2, OutlineVertex and Outline are shared with the duct core. -->
    <Compile Include="..\..\cad_addin\src\DuctGeometryCore.cs" Link="DuctGeometryCore.cs" />
    <Compile Include="..\..\cad_addin\src\RouteDraftCore.cs" Link="RouteDraftCore.cs" />
    <!-- The HVACREFRIG cleaner, to check that a draft is accepted as its input. -->
    <Compile Include="..\..\cad_addin\src\PipeCatalogCore.cs" Link="PipeCatalogCore.cs" />
    <Compile Include="..\..\cad_addin\src\PipeSettingsCore.cs" Link="PipeSettingsCore.cs" />
    <Compile Include="..\..\cad_addin\src\PipeNetworkCore.cs" Link="PipeNetworkCore.cs" />
    <Compile Include="..\..\cad_addin\src\RefrigCleanerCore.cs" Link="RefrigCleanerCore.cs" />
    <Compile Include="..\..\cad_addin\src\NetworkTopologyCore.cs" Link="NetworkTopologyCore.cs" />
    <Compile Include="..\PipeCoreTests\Check.cs" Link="Check.cs" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
