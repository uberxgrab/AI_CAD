<Project>
  <!--
    Headless accoreconsole test for the HVACPLACEODU and HVACRISER writers (block import from the template, fallback
    blocks, insertion, xdata, replacement on a rerun, riser markers and schedule). The DLL links the sources it tests and references
    only AcDbMgd and AcCoreMgd (never AcMgd). Build folders stay in %TEMP%. Run it with run-tests.ps1.
  -->
  <PropertyGroup>
    <OduRiserAcadBuildRoot>$([System.IO.Path]::GetTempPath())OduRiserAcadTests\</OduRiserAcadBuildRoot>
    <BaseIntermediateOutputPath>$(OduRiserAcadBuildRoot)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(OduRiserAcadBuildRoot)bin\</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>OduRiserAcadTests</RootNamespace>
    <AssemblyName>OduRiserAcadTests</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <Import Project="..\..\..\cad_addin\AcadDir.props" />

  <ItemGroup>
    <Compile Include="OduRiserAcadTests.cs" />
    <Compile Include="..\..\..\cad_addin\src\DuctGeometryCore.cs" Link="DuctGeometryCore.cs" />
    <Compile Include="..\..\..\cad_addin\src\PipeCatalogCore.cs" Link="PipeCatalogCore.cs" />
    <Compile Include="..\..\..\cad_addin\src\PipeSettingsCore.cs" Link="PipeSettingsCore.cs" />
    <Compile Include="..\..\..\cad_addin\src\PipeNetworkCore.cs" Link="PipeNetworkCore.cs" />
    <Compile Include="..\..\..\cad_addin\src\RefrigCleanerCore.cs" Link="RefrigCleanerCore.cs" />
    <Compile Include="..\..\..\cad_addin\src\NetworkTopologyCore.cs" Link="NetworkTopologyCore.cs" />
    <Compile Include="..\..\..\cad_addin\src\RefrigSizingCore.cs" Link="RefrigSizingCore.cs" />
    <Compile Include="..\..\..\cad_addin\src\OduCore.cs" Link="OduCore.cs" />
    <Compile Include="..\..\..\cad_addin\src\RiserCore.cs" Link="RiserCore.cs" />
    <Compile Include="..\..\..\cad_addin\src\OduWriter.cs" Link="OduWriter.cs" />
    <Compile Include="..\..\..\cad_addin\src\RiserWriter.cs" Link="RiserWriter.cs" />
    <Compile Include="..\..\..\cad_addin\src\TemplateImport.cs" Link="TemplateImport.cs" />
    <Compile Include="..\..\..\cad_addin\src\TestMode.cs" Link="TestMode.cs" />
    <Reference Include="AcDbMgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
