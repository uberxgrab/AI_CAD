<Project>
  <!--
    Console tests for the AutoCAD-free duct maths (cad_addin/src/DuctGeometryCore.cs).
    Sdk.props is imported explicitly so the build folders can be set first: bin/ and obj/
    stay in %TEMP%, outside the repository and outside cad_addin/ (whose SDK glob would
    compile this project into the add-in).
  -->
  <PropertyGroup>
    <DuctCoreBuildRoot>$([System.IO.Path]::GetTempPath())DuctCoreTests\</DuctCoreBuildRoot>
    <BaseIntermediateOutputPath>$(DuctCoreBuildRoot)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(DuctCoreBuildRoot)bin\</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DuctCoreTests</RootNamespace>
    <AssemblyName>DuctCoreTests</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\cad_addin\src\DuctGeometryCore.cs" Link="DuctGeometryCore.cs" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
